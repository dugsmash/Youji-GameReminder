{
  "name": "game-remainder",
  "productName": "游迹 · 游戏任务记录器",
  "version": "1.0.0",
  "description": "面向 PC 的悬浮置顶游戏任务记录器：多游戏隔离，每日/每周/主线/活动任务一键勾选，透明毛玻璃窗口。",
  "type": "module",
  "main": "main.cjs",
  "author": "GameRemainder",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "shots": "electron . --shots",
    "test": "node test/model.test.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "pack": "electron-builder --win",
    "pack:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gameremainder.app",
    "productName": "游迹",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "游迹-${version}.exe"
    }
  }
}
